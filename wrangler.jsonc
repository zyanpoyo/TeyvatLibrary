{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teyvat-library",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "teyvat-bunko.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "404-page"
  },
  "previews": {}
}
