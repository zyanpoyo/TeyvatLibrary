{
  "name": "genshin-books",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "テイワット文庫 — 原神 聖遺物・武器・書籍リーダー",
  "scripts": {
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "extract-raw": "node scripts/extract-raw.mjs",
    "sync-corpus": "node scripts/sync-corpus.mjs",
    "build:data": "node scripts/build-stories.mjs",
    "validate": "node scripts/build-stories.mjs --validate-only",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "genshin-data": "^0.65.1",
    "genshin-db": "^5.2.15",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  }
}
