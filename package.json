{
  "name": "genshin-books",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "テイワット文庫 — 原神 聖遺物・武器・書籍リーダー",
  "scripts": {
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && vite build",
    "preview": "vite preview",
    "extract-raw": "node scripts/extract-raw.mjs",
    "sync-corpus": "node scripts/sync-corpus.mjs",
    "build:data": "node scripts/build-stories.mjs",
    "validate": "node scripts/build-stories.mjs --validate-only",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "genshin-data": "^0.65.1",
    "genshin-db": "^5.2.15",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@oddbird/popover-polyfill": "^0.7.3"
  }
}
