{
  "name": "genshin-books",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "テイワット文庫 — 原神 聖遺物・武器・書籍リーダー",
  "scripts": {
    "dev": "npm run build:data && react-router dev",
    "build": "npm run build:data && npm run typecheck && react-router build",
    "typecheck": "react-router typegen && tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "lint": "oxlint -c .oxlintrc.json src",
    "preview": "node scripts/preview-static.mjs",
    "extract-raw": "node scripts/extract-raw.mjs",
    "sync-corpus": "node scripts/sync-corpus.mjs",
    "lore:inspect": "node scripts/lore-tools.mjs inspect",
    "lore:search": "node scripts/lore-tools.mjs search",
    "build:data": "node scripts/build-stories.mjs",
    "build:og": "node scripts/generate-og-images.mjs",
    "validate": "node scripts/build-stories.mjs --validate-only",
    "skills:check": "node scripts/check-skills-upstream.mjs",
    "skills:validate": "node scripts/check-skills-upstream.mjs --validate-only",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@fontsource/shippori-mincho": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "genshin-data": "^0.65.1",
    "genshin-db": "^5.2.15",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "satori": "^0.63.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  }
}
