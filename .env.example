# Google Analytics 4 (GA4) 測定ID（本番ビルドかつローカルホスト以外で自動有効化）
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ローカル開発・プレビュー環境で GA4 DebugView 疎通確認する時のみ true に設定
# VITE_GA_DEBUG=false

# About ページのお問い合わせ先設定（任意：既定の GitHub Issues / 専用フォーム / X URL を上書き・メール追加する場合に指定）
# VITE_GITHUB_ISSUES_URL=https://github.com/zyanpoyo/TeyvatLibrary/issues
# VITE_CONTACT_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLScrKc3YA_ItOhFH5-ZOccgwfYJr5tiq9UY7JMcHznZoHkiM5Q/viewform?usp=header
# VITE_CONTACT_X_URL=https://x.com/zyanpoyo
# VITE_CONTACT_EMAIL=contact@example.com

# 公開基準 URL（本番ドメイン確定時に設定すると canonical・sitemap.xml・robots.txt に反映）
# VITE_SITE_URL=https://example.com
